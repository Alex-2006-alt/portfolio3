generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String?
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  link        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TechStack {
  id        String   @id @default(uuid())
  name      String
  category  String
  iconName  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id          String   @id @default(uuid())
  title       String
  description String
  statValue   String
  statLabel   String
  order       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  title       String
  role        String
  date        String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id          String @id @default("default")
  heroTitle   String @default("John Doe")
  heroSub     String @default("Software Engineer")
  aboutText   String @default("I build modern web apps.")
  email       String @default("hello@example.com")
  githubUrl   String @default("")
  linkedinUrl String @default("")
  twitterUrl  String @default("")
  yearsExperience    String @default("5+")
  projectsCompleted  String @default("50+")
  clientSatisfaction String @default("100%")
  updatedAt   DateTime @updatedAt
}
